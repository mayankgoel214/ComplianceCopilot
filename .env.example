# The only secret Verity needs.
#
# Create one at https://aistudio.google.com/apikey. Everything that embeds a
# query or calls the model reads this; /search and /evaluation render from the
# committed index without it, but /assess will not run.
GOOGLE_GEMINI_API_KEY=

# Optional. Sets the absolute URL used for Open Graph images. Vercel provides
# VERCEL_PROJECT_PRODUCTION_URL automatically, so this is only needed elsewhere.
# NEXT_PUBLIC_SITE_URL=https://verity-compliance.vercel.app

# Optional, and only for `npm run test:db`. The pgvector integration suite skips
# itself unless this is set; docker-compose.test.yml starts a matching database.
# VERITY_TEST_DATABASE_URL=postgres://postgres:verity@localhost:55432/verity_test
