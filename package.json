{
  "name": "verity",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --testEnvironment=node",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:e2e": "playwright test",
    "test:db": "docker compose -f docker-compose.test.yml up -d && VERITY_TEST_DATABASE_URL=postgres://postgres:verity@localhost:55432/verity_test NODE_OPTIONS=--experimental-vm-modules jest --testEnvironment=node pgvector",
    "corpus:fetch": "node scripts/fetch-corpus.mjs",
    "index:build": "tsx --env-file=.env.local scripts/build-index.mts",
    "eval": "tsx --env-file=.env.local eval/run-eval.mts",
    "eval:chunking": "tsx --env-file=.env.local scripts/chunking-experiment.mts",
    "db:migrate": "tsx --env-file=.env.local scripts/db-migrate.mts",
    "corpus:push": "tsx --env-file=.env.local scripts/push-corpus.mts",
    "eval:parity": "tsx --env-file=.env.local eval/pgvector-parity.mts",
    "eval:adversarial": "tsx --env-file=.env.local eval/adversarial/run.mts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/google-genai": "^2.3.0",
    "@napi-rs/canvas": "^1.0.8",
    "@sentry/nextjs": "^10.72.0",
    "@upstash/redis": "^1.38.3",
    "clsx": "^2.1.1",
    "langchain": "^1.5.10",
    "lucide-react": "^0.544.0",
    "mammoth": "^1.12.2",
    "next": "^15.5.23",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^15.5.23",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "whatwg-fetch": "^3.6.20"
  },
  "description": "Compliance assessment over a measured retrieval stack, with verified citations."
}
